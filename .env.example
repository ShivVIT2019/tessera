# Buffer OAuth app client (Settings → API → App Clients). Copy to .env.local.
BUFFER_CLIENT_ID=
# Only for confidential clients; leave empty for a public PKCE client.
BUFFER_CLIENT_SECRET=
# Optional. Must match a redirect URI registered in Buffer exactly (Buffer requires HTTPS).
# Defaults to <origin>/api/auth/callback; locally run `npx next dev --experimental-https`.
BUFFER_REDIRECT_URI=
# Random string, at least 32 chars, used to encrypt the session cookie: openssl rand -base64 32
SESSION_SECRET=
